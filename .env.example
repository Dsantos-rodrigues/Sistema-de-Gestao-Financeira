# .env.example — copie para .env antes de subir o Docker
#
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#
# NUNCA commite o arquivo .env — ele já está no .gitignore

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financeiro

# ─── Backend NestJS (Prisma) ──────────────────────────────────────────────────
# IMPORTANTE: o host é "postgres" (nome do serviço no docker-compose)
# Para rodar o backend FORA do Docker, troque "postgres" por "localhost"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/financeiro

JWT_SECRET=troque_por_uma_chave_secreta_segura
PORT=3000
BRAPI_API_KEY=

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
# URL do backend acessada pelo browser do usuário
# Em Docker: http://localhost:3000 (o browser acessa o host, não o container)
# Para rodar o frontend FORA do Docker, crie frontend/.env.local com essa variável
NEXT_PUBLIC_API_URL=http://localhost:3000
